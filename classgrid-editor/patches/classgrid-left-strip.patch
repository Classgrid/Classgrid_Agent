diff --git a/src/vs/workbench/contrib/webviewView/browser/classgridStrip.ts b/src/vs/workbench/contrib/webviewView/browser/classgridStrip.ts
new file mode 100644
index 0000000..31fbee1
--- /dev/null
+++ b/src/vs/workbench/contrib/webviewView/browser/classgridStrip.ts
@@ -0,0 +1,144 @@
+/*---------------------------------------------------------------------------------------------
+ *  Classgrid Code: our chats sidebar on the window's left edge, like Project Mode's left side in the Classgrid app.
+ *  It is a page of the Classgrid extension (the webview view "classgrid.chats", classgrid-editor/extension), shown
+ *  over its own place in the workbench (left of VS Code's icons, below the title bar: layout.ts). The page says how
+ *  wide it is (_classgrid.setStripWidth: the icon strip, open with the chat history, or 0 when dragged away), and the
+ *  sidebar button next to the logo in the title bar shows or hides it, like Project Mode's.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { CancellationTokenSource } from '../../../../base/common/cancellation.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ExtensionIdentifier } from '../../../../platform/extensions/common/extensions.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IExtensionService } from '../../../services/extensions/common/extensions.js';
+import { IWorkbenchLayoutService } from '../../../services/layout/browser/layoutService.js';
+import { IOverlayWebview, IWebviewService, WebviewContentPurpose } from '../../webview/browser/webview.js';
+import { IWebviewViewService } from './webviewViewService.js';
+
+const VIEW_TYPE = 'classgrid.chats';
+
+let strip: ClassgridStrip | undefined;
+
+class ClassgridStrip extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.classgridStrip';
+
+	private readonly host: HTMLElement | undefined;
+	private readonly webview: IOverlayWebview;
+
+	constructor(
+		@IWorkbenchLayoutService layoutService: IWorkbenchLayoutService,
+		@IWebviewService webviewService: IWebviewService,
+		@IWebviewViewService webviewViewService: IWebviewViewService,
+		@IExtensionService extensionService: IExtensionService,
+		@ICommandService private readonly commandService: ICommandService,
+	) {
+		super();
+
+		// Its place in the workbench (layout.ts)
+		this.host = mainWindow.document.querySelector<HTMLElement>('.classgrid-strip-host') ?? undefined;
+
+		this.webview = this._register(webviewService.createWebviewOverlay({
+			providedViewType: VIEW_TYPE,
+			title: 'Chats',
+			options: { purpose: WebviewContentPurpose.WebviewView, retainContextWhenHidden: true },
+			contentOptions: {},
+			extension: { id: new ExtensionIdentifier('classgrid.classgrid') },
+		}));
+		// (marked, so the Agent panel's own rules for its big windows leave this page alone: workbench.css)
+		this.webview.container.classList.add('classgrid-strip');
+		this.place();
+		this.webview.claim(this, mainWindow, undefined);
+
+		strip = this;
+		this._register({ dispose: () => { if (strip === this) { strip = undefined; } } });
+		this._register(layoutService.onDidLayoutMainContainer(() => this.place()));
+		if (this.host) {
+			const host = this.host;
+			const onLayout = () => this.place();
+			host.addEventListener('classgrid-strip-layout', onLayout);
+			this._register({ dispose: () => host.removeEventListener('classgrid-strip-layout', onLayout) });
+		}
+
+		// The sidebar button next to the logo in the title bar (kept there when the title bar redraws)
+		this.addTitleBarButton();
+		const titleBar = mainWindow.document.querySelector('.part.titlebar');
+		if (titleBar) {
+			const observer = new MutationObserver(() => this.addTitleBarButton());
+			observer.observe(titleBar, { childList: true, subtree: true });
+			this._register({ dispose: () => observer.disconnect() });
+		}
+
+		// The extension's page for it, like a webview view in a side bar
+		const visibility = this._register(new Emitter<boolean>());
+		const disposed = this._register(new Emitter<void>());
+		const cancel = this._register(new CancellationTokenSource());
+		extensionService.activateByEvent(`onView:${VIEW_TYPE}`).then(() => webviewViewService.resolve(VIEW_TYPE, {
+			webview: this.webview,
+			onDidChangeVisibility: visibility.event,
+			onDispose: disposed.event,
+			dispose: () => { /* the sidebar stays for the window's whole life */ },
+			show: () => { /* always shown */ },
+		}, cancel.token));
+	}
+
+	private place(): void {
+		if (this.host) {
+			this.webview.setAnchorElement(this.host);
+		}
+	}
+
+	private addTitleBarButton(): void {
+		const left = mainWindow.document.querySelector('.part.titlebar .titlebar-left');
+		if (!left || left.querySelector('.classgrid-strip-toggle')) {
+			return;
+		}
+		const button = mainWindow.document.createElement('a');
+		button.className = 'classgrid-strip-toggle codicon codicon-layout-sidebar-left';
+		button.title = 'Show or hide the sidebar';
+		button.setAttribute('role', 'button');
+		button.setAttribute('aria-label', 'Show or hide the sidebar');
+		button.tabIndex = 0;
+		const toggle = () => { this.commandService.executeCommand('classgrid.toggleChats'); };
+		button.addEventListener('click', toggle);
+		button.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); } });
+		const appIcon = left.querySelector('.window-appicon');
+		if (appIcon) {
+			appIcon.after(button);
+		} else {
+			left.prepend(button);
+		}
+	}
+
+	focus(): void {
+		this.webview.focus();
+	}
+
+	setWidth(width: number): void {
+		const w = Math.max(0, Math.min(600, Math.round(Number(width) || 0)));
+		(mainWindow as unknown as { classgridSetStripWidth?: (width: number) => void }).classgridSetStripWidth?.(w);
+		this.place();
+	}
+}
+
+registerWorkbenchContribution2(ClassgridStrip.ID, ClassgridStrip, WorkbenchPhase.AfterRestored);
+
+CommandsRegistry.registerCommand('_classgrid.setStripWidth', (_accessor, width: number) => {
+	strip?.setWidth(width);
+});
+// Typing goes to the chats sidebar (Ctrl+K opens its chat history search there)
+CommandsRegistry.registerCommand('_classgrid.focusStrip', () => {
+	strip?.focus();
+});
+// A big window of the chats sidebar (the chat search, a dialog): its page covers the whole window like the Agent
+// panel's Plugins window, with the sidebar drawn in its place (classgrid-editor/workbench.css does the covering)
+CommandsRegistry.registerCommand('_classgrid.stripRect', () => {
+	const r = mainWindow.document.querySelector('.classgrid-strip-host')?.getBoundingClientRect();
+	return r ? { top: r.top, left: r.left, width: r.width, height: r.height } : undefined;
+});
+CommandsRegistry.registerCommand('_classgrid.setStripOverlay', (_accessor, on: boolean) => {
+	mainWindow.document.body.classList.toggle('classgrid-strip-overlay', !!on);
+});
