diff --git a/src/vs/workbench/contrib/webviewView/browser/classgridSettingsButton.ts b/src/vs/workbench/contrib/webviewView/browser/classgridSettingsButton.ts
new file mode 100644
index 0000000..7d3c132
--- /dev/null
+++ b/src/vs/workbench/contrib/webviewView/browser/classgridSettingsButton.ts
@@ -0,0 +1,21 @@
+/*---------------------------------------------------------------------------------------------
+ *  Classgrid Code: a gear in the title bar, next to the layout buttons, that opens Classgrid Code's Settings tab
+ *  (the Classgrid extension's command "classgrid.openSettings", classgrid-editor/extension). It is one of the title
+ *  bar's own buttons, drawn and clicked like the layout buttons beside it.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Codicon } from '../../../../base/common/codicons.js';
+import { localize } from '../../../../nls.js';
+import { MenuId, MenuRegistry } from '../../../../platform/actions/common/actions.js';
+import { IsAuxiliaryWindowContext } from '../../../common/contextkeys.js';
+
+MenuRegistry.appendMenuItem(MenuId.LayoutControlMenu, {
+	group: 'navigation',
+	order: -1,
+	command: {
+		id: 'classgrid.openSettings',
+		title: localize('classgridSettings', "Settings"),
+		icon: Codicon.settingsGear,
+	},
+	when: IsAuxiliaryWindowContext.toNegated(),
+});
