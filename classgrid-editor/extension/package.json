{
  "name": "classgrid",
  "displayName": "Classgrid",
  "description": "The Classgrid AI inside Classgrid Code: the Agent chat on the right side, and the AI's terminal, files and memory on this computer.",
  "publisher": "classgrid",
  "version": "0.1.5",
  "private": false,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.98.0"
  },
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onWebviewPanel:classgrid"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.colorTheme": "Dark Modern",
      "workbench.preferredDarkColorTheme": "Dark Modern",
      "workbench.preferredLightColorTheme": "Light Modern",
      "workbench.layoutControl.type": "toggles",
      "files.autoSave": "afterDelay",
      "code-runner.runInTerminal": true,
      "code-runner.saveFileBeforeRun": true,
      "code-runner.clearPreviousOutput": true,
      "code-runner.showRunCommandInEditorContextMenu": true,
      "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/dist/**": true,
        "**/build/**": true
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "classgrid-sidebar",
          "title": "Classgrid",
          "icon": "media/classgrid-activity.png"
        }
      ],
      "secondarySidebar": [
        {
          "id": "classgrid",
          "title": "Classgrid",
          "icon": "media/classgrid-activity.png"
        }
      ]
    },
    "views": {
      "classgrid-sidebar": [
        {
          "type": "webview",
          "id": "classgrid.sidebar",
          "name": "Agent",
          "icon": "media/classgrid-activity.png",
          "when": "classgrid.stockEditor"
        }
      ],
      "classgrid": [
        {
          "type": "webview",
          "id": "classgrid.agent",
          "name": "Agent",
          "icon": "media/classgrid-activity.png"
        }
      ]
    },
    "commands": [
      {
        "command": "classgrid.showAgent",
        "title": "Classgrid: Show the Agent",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "classgrid.open",
        "title": "Classgrid: Open Classgrid (Agent, Studio, Projects)"
      },
      {
        "command": "classgrid.searchChats",
        "title": "Classgrid: Search Chat History"
      },
      {
        "command": "classgrid.openSettings",
        "title": "Classgrid: Settings"
      },
      {
        "command": "classgrid.signIn",
        "title": "Classgrid: Sign in"
      },
      {
        "command": "classgrid.pasteSignInCode",
        "title": "Classgrid: Paste sign-in code"
      },
      {
        "command": "classgrid.signOut",
        "title": "Classgrid: Sign out"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "classgrid.showAgent",
          "group": "navigation@-100"
        }
      ]
    },
    "keybindings": [
      {
        "command": "classgrid.searchChats",
        "key": "ctrl+k",
        "mac": "cmd+k"
      }
    ]
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Classgrid/Classgrid_Agent"
  },
  "bugs": {
    "url": "https://github.com/Classgrid/Classgrid_Agent/issues"
  },
  "homepage": "https://classgrid.in",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "classgrid",
    "ai",
    "agent",
    "chat",
    "studio"
  ],
  "files": [
    "extension.js",
    "bridge.js",
    "editor-context.js",
    "electron-shim.js",
    "media/**",
    "package.json",
    "LICENSE.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "package": "vsce package --no-dependencies --out classgrid-0.1.0.vsix",
    "publish": "vsce publish --no-dependencies"
  }
}
