{
  "name": "classgrid",
  "displayName": "Classgrid",
  "description": "The Classgrid AI inside Classgrid Code: the Agent chat on the right side, and the AI's terminal, files and memory on this computer.",
  "publisher": "classgrid",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.98.0"
  },
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "workbench.colorTheme": "Dark Modern",
      "workbench.preferredDarkColorTheme": "Dark Modern",
      "workbench.preferredLightColorTheme": "Light Modern",
      "workbench.layoutControl.type": "toggles",
      "files.autoSave": "afterDelay",
      "code-runner.runInTerminal": true,
      "code-runner.saveFileBeforeRun": true,
      "code-runner.clearPreviousOutput": true,
      "code-runner.showRunCommandInEditorContextMenu": true,
      "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/dist/**": true,
        "**/build/**": true
      },
      "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "classgrid",
          "title": "Classgrid",
          "icon": "media/classgrid.svg"
        }
      ]
    },
    "views": {
      "classgrid": [
        {
          "type": "webview",
          "id": "classgrid.agent",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "classgrid.showAgent",
        "title": "Classgrid: Show the Agent"
      },
      {
        "command": "classgrid.open",
        "title": "Classgrid: Open Classgrid (Agent, Studio, Projects)"
      },
      {
        "command": "classgrid.searchChats",
        "title": "Classgrid: Search Chat History"
      },
      {
        "command": "classgrid.toggleChats",
        "title": "Classgrid: Show or Hide the Sidebar"
      }
    ],
    "keybindings": [
      {
        "command": "classgrid.searchChats",
        "key": "ctrl+k",
        "mac": "cmd+k"
      }
    ]
  }
}
