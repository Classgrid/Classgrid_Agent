{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "classgrid": {
      "type": "streamable-http",
      "url": "https://api.classgrid.in/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "profile:read",
              "offline_access"
            ],
            "defaultScopes": [
              "profile:read",
              "schedules:read",
              "schedules:write",
              "grid:read",
              "grid:write",
              "projects:read",
              "chats:read",
              "skills:read",
              "docs:read",
              "docs:write",
              "pages:write",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
